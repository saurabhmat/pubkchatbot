# Supabase project URL and anon (public) key — from Supabase dashboard > Project Settings > API.
# The anon key is safe to expose in a client bundle; RLS policies on the Supabase
# side restrict reads to authenticated users only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: cost-estimate constants used on the Stats page, in dollars per million tokens.
# These are placeholders — update them to match your actual Anthropic model pricing.
# If unset, the app defaults to VITE_PRICE_IN=1.00 and VITE_PRICE_OUT=5.00.
VITE_PRICE_IN=1.00
VITE_PRICE_OUT=5.00
